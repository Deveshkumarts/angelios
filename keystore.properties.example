# Copy to keystore.properties (git-ignored) and fill in to sign release builds.
# Create a key:  keytool -genkeypair -v -keystore itantra-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias itantra
storeFile=itantra-release.jks
storePassword=CHANGE_ME
keyAlias=itantra
keyPassword=CHANGE_ME
